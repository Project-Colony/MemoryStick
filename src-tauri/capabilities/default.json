{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "What the MemoryStick window may call, and only from the app's own pages",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "allow-open-document",
    "allow-load-file",
    "allow-save-preferences",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "https://*" }, { "url": "http://*" }, { "url": "mailto:*" }]
    }
  ]
}
